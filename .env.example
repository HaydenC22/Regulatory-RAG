# LLM provider (generation, agent tool-calls, RAGAS judge)
# Default is Gemini's free tier — get a key at https://aistudio.google.com/apikey (no card needed).
# See ADR-0004. Set LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY to switch back to paid Claude.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_CHEAP=gemini-flash-lite-latest
LLM_MODEL_QUALITY=gemini-flash-lite-latest

# Tracing (optional but recommended — captures retrieval/rerank/generation spans)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=regulatory-rag-p2
LANGSMITH_TRACING=false

# Embeddings — local by default so ingestion + CI need no API key
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/regulatory_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=regulatory_rag

# Retrieval tuning
RERANK_THRESHOLD=0.0
RETRIEVAL_TOP_K=5

# API
API_BASE_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=20
